# =====================================================================
# Sidharth Shutter CRM - secrets and login accounts
# ---------------------------------------------------------------------
# LOCAL:  save as  .streamlit/secrets.toml  inside the project folder.
# CLOUD:  paste everything into  App -> Settings -> Secrets.
# NEVER commit this file to GitHub (it is already in .gitignore).
#
# How accounts work:
#   - Every [accounts.<username>] below is created when the app starts,
#     if no account with that email exists yet.
#   - Sign in with the username (e.g. pooja), the email, or employee_id.
#   - Existing accounts are never overwritten. If someone changes their
#     password in "My account", the new password wins until the database
#     is reset (on Streamlit Cloud: every reboot / redeploy).
#   - To add a person: copy a block, change the username, details and
#     password, save, and reboot the app.
#   - Roles: ADMIN, LGE, QS, SAM, OPERATIONS
# =====================================================================

[database]
engine = "sqlite"
sqlite_path = "data/crm_database.db"

[bootstrap]
# Sample leads for testing. Set to "false" before entering real data.
seed_demo_data = "true"
# "true" = on start-up, reset every account below to the password written here
# (fixes "password doesn't work" for accounts created earlier).
sync_passwords = "true"

# ---------------------------------------------------------------- accounts
